# SITE_ADDRESS controls how the site is served:
#   - a domain (e.g. chat.example.com)  -> automatic HTTPS via Let's Encrypt
#   - :80                               -> plain HTTP (IP-only testing)
{$SITE_ADDRESS::80} {
	encode gzip

	# API: strip the /api prefix, then forward to the backend.
	# (backend routes are /auth, /channels, ... with no /api prefix)
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# WebSocket endpoint — Caddy upgrades the connection automatically.
	handle /ws {
		reverse_proxy backend:8000
	}

	# Everything else: serve the SPA, falling back to index.html for routes.
	handle {
		root * /srv
		# SEO: the app is served on both chat.openrelay.pl (legacy) and the
		# canonical orc.openrelay.pl. Mark everything on the old hostname
		# noindex so search engines only index orc (the page canonicals point
		# there too). The desktop app uses chat solely for /api + /ws, handled
		# above, so this header never reaches it.
		@oldhost host chat.openrelay.pl
		header @oldhost X-Robots-Tag "noindex"
		# Don't cache the entry document or version file so new deploys are
		# picked up immediately (hashed JS/CSS assets stay cacheable).
		# sw.js is included deliberately: a cached service worker is slow to
		# dislodge, which turns a bad one into a lasting problem.
		@nocache path / /index.html /version.json /sw.js
		header @nocache Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

# Old-domain redirect. Set REDIRECT_FROM to a retired domain (e.g.
# old.example.com) and Caddy serves it, gets a cert for it, and 301s every path
# to the canonical site below. Left at the localhost default it binds a
# throwaway HTTP-only site (no ACME attempts), so local :80 testing stays quiet.
{$REDIRECT_FROM:http://localhost:8099} {
	redir https://chat.openrelay.pl{uri} permanent
}
