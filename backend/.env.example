# Copy to .env and adjust for your environment.

# Postgres (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — GENERATE A REAL SECRET for production:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated origins allowed to call the API (your frontend)
CORS_ORIGINS=http://localhost:5173

# Rate limiting
MSG_RATE_PER_10S=10
LOGIN_RATE_PER_MIN=10

# --- SSO / OAuth (optional; leave blank to disable a provider) ---
# PUBLIC_BASE_URL is the origin the browser hits (used to build redirect URIs).
PUBLIC_BASE_URL=http://localhost:5173
# Google: console.cloud.google.com -> OAuth client (Web). Authorized redirect:
#   http://localhost:5173/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord: discord.com/developers -> your app -> OAuth2. Redirect:
#   http://localhost:5173/api/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Giphy GIF picker (optional). Free key: developers.giphy.com
GIPHY_API_KEY=
