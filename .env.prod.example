# Copy to .env.prod on the VPS and fill in real values.
#   cp .env.prod.example .env.prod

# --- Database ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=chat

# --- Auth --- generate with:  openssl rand -base64 64
JWT_SECRET=CHANGE_ME_long_random_secret

# --- Public address ---------------------------------------------------------
# With a domain pointed at this VPS, Caddy gets HTTPS automatically:
#   SITE_ADDRESS=chat.example.com
# For IP-only testing (plain HTTP), leave it as :80
SITE_ADDRESS=:80

# Same-origin in this setup, so CORS is not strictly needed, but keep it
# accurate: set to your public URL(s).
CORS_ORIGINS=http://localhost

# Host port mapping (leave 80/443 for a real VPS).
HTTP_PORT=80
HTTPS_PORT=443

MSG_RATE_PER_10S=10
LOGIN_RATE_PER_MIN=10

# --- SSO / OAuth (optional) ---
# Your public origin (used to build redirect URIs). Match SITE_ADDRESS domain.
PUBLIC_BASE_URL=https://chat.example.com
# Register these redirect URIs with each provider:
#   https://chat.example.com/api/auth/oauth/google/callback
#   https://chat.example.com/api/auth/oauth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
